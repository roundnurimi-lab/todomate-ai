# 복사해서 .env로 사용 (.env는 절대 커밋 금지). 아래는 로컬 개발용 더미 값.
APP_NAME=TodoMate AI
ENVIRONMENT=local
LOG_LEVEL=INFO

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=todomate
MYSQL_USER=todomate
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306
# pragma: allowlist nextline secret
DATABASE_URL=mysql+asyncmy://todomate:change-me@127.0.0.1:3306/todomate

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# ChromaDB
CHROMA_PORT=8001

# Neo4j
NEO4J_PASSWORD=change-me-neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# LLM (실제 키는 .env에만)
OPENAI_API_KEY=
